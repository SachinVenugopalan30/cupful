#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
# Fast checks for staged changes. Install with ./scripts/install-hooks.sh.
set -eu

root=$(git rev-parse --show-toplevel)
cd "$root"

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -n "$staged" ] || exit 0

if printf '%s\n' "$staged" | grep -Eq '^server/'; then
	echo "pre-commit: cargo fmt --check"
	(cd server && cargo fmt --check)
fi

if printf '%s\n' "$staged" | grep -Eq '^web/'; then
	echo "pre-commit: svelte-check"
	(cd web && npm run check)
	echo "pre-commit: Vitest"
	(cd web && npm test)
fi
