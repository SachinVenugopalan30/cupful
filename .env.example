# Tailscale sidecar (compose.yaml). Create an auth key at https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY=
TS_HOSTNAME=cupful

# Cupful. Every setting is optional.
# Where the AGPL "Source code" link points. Change it if you run a modified version.
# CUPFUL_SOURCE_URL=https://github.com/SachinVenugopalan30/cupful
# Set to the reverse proxy's address when running without Tailscale behind a proxy that sets X-Forwarded-For.
# CUPFUL_TRUSTED_PROXY=172.17.0.1
# Only for plain-HTTP local development; leave on behind HTTPS.
# CUPFUL_SECURE_COOKIES=false
# Barcode lookups ask Open Food Facts (world.openfoodfacts.org) about products not stored here yet.
# Each lookup tells Open Food Facts which barcode was scanned. `off` stops these calls; stored
# products and "enter from the label" still work.
# CUPFUL_PRODUCT_LOOKUP=off

# Secrets at rest. AI provider keys are encrypted with this key: 32 random bytes in base64
# (`openssl rand -base64 32`). Unset, Cupful creates /data/secret.key on first start. A key kept
# here, apart from the data volume, protects more than one stored next to the database. Losing it
# means re-entering provider keys; nothing else is lost.
# CUPFUL_SECRET_KEY=

# AI providers. These seed ONE provider, only while no provider exists yet; after that the
# database wins and Settings is where you change providers (a notice is logged if these differ).
# See docs/providers.md. The default points at Ollama on the Docker host (OLLAMA_HOST=0.0.0.0).
# Kind: openai_compatible (OpenAI, Ollama, llama.cpp, OpenRouter, ...), anthropic or gemini.
CUPFUL_PROVIDER_KIND=openai_compatible
CUPFUL_PROVIDER_LABEL=Ollama
CUPFUL_PROVIDER_BASE_URL=http://host.docker.internal:11434/v1
CUPFUL_PROVIDER_MODEL=llama3.2
# Local providers have no daily call cap.
CUPFUL_PROVIDER_LOCAL=true
# Can it read photos? Also makes it the default photo provider.
# CUPFUL_PROVIDER_VISION=false
# CUPFUL_PROVIDER_API_KEY=
# JSON object of extra request headers, e.g. Azure OpenAI: {"api-key": "..."}
# CUPFUL_PROVIDER_EXTRA_HEADERS=
# native (the provider's JSON-schema output) or prompt (ask for JSON; for servers without it).
# CUPFUL_PROVIDER_STRUCTURED_OUTPUT=native
# Calls per user per day to hosted (non-local) providers.
# CUPFUL_AI_DAILY_CAP=200

# Log level: error, warn, info, debug, trace.
# RUST_LOG=info
