# SPDX-License-Identifier: AGPL-3.0-or-later

# Tailscale sidecar. Create an auth key at https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY=

# Tailscale machine name. The site is served at https://<TS_HOSTNAME>.<your-tailnet>.ts.net
TS_HOSTNAME=cupful

# Map the Tailscale-User-Login header to a Cupful session. Only for the sidecar path.
# Requires a loopback bind (the provided compose.yaml does this). Leave unset otherwise.
# CUPFUL_TRUST_TAILSCALE=false

# Cupful. Every setting below is optional.

# Address the server listens on. The image sets 0.0.0.0:8080; compose.yaml sets 127.0.0.1:8080.
# CUPFUL_BIND=0.0.0.0:8080

# Directory for cupful.db and secret.key. The image sets /data.
# CUPFUL_DATA_DIR=/data

# Session cookie Secure flag. Leave on behind HTTPS. Set false only for plain-HTTP local development.
# CUPFUL_SECURE_COOKIES=false

# Reverse proxy address allowed to set the client IP from X-Forwarded-For. Set this behind a proxy.
# CUPFUL_TRUSTED_PROXY=172.17.0.1

# Public HTTPS address of this instance, without a trailing slash. Used for the Google redirect URI.
# CUPFUL_PUBLIC_URL=https://cupful.your-tailnet.ts.net

# Where the AGPL source link points. Change it if you run a modified version.
# CUPFUL_SOURCE_URL=https://github.com/SachinVenugopalan30/cupful

# Barcode lookups ask Open Food Facts about products not stored here yet. off disables them.
# CUPFUL_PRODUCT_LOOKUP=off

# Key for secrets at rest: 32 random bytes in base64 (openssl rand -base64 32).
# Unset: Cupful creates /data/secret.key on first start. Losing the key loses only provider keys and Google tokens.
# CUPFUL_SECRET_KEY=

# AI provider seeded on first start, only while no provider exists. After that, Settings wins.
CUPFUL_PROVIDER_KIND=openai_compatible
CUPFUL_PROVIDER_LABEL=Ollama
CUPFUL_PROVIDER_BASE_URL=http://host.docker.internal:11434/v1
CUPFUL_PROVIDER_MODEL=llama3.2
CUPFUL_PROVIDER_LOCAL=true
CUPFUL_PROVIDER_VISION=false
CUPFUL_PROVIDER_API_KEY=
CUPFUL_PROVIDER_EXTRA_HEADERS=
CUPFUL_PROVIDER_STRUCTURED_OUTPUT=native

# Hosted AI calls per user per day. Local providers are not capped.
# CUPFUL_AI_DAILY_CAP=200

# Google Health steps sync. Both values are required to show the feature.
# CUPFUL_GOOGLE_CLIENT_ID=
# CUPFUL_GOOGLE_CLIENT_SECRET=

# Log level: error, warn, info, debug or trace. Use cupful=debug for model replies.
# RUST_LOG=info
